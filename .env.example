# Copy this file to .env and fill in your key, or set it from the app's Settings page.
# Get a key at https://platform.deepseek.com/api_keys

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Your exam date (YYYY-MM-DD). Drives the countdown and the study plan.
EXAM_DATE=

# Local server port
PORT=4321
