# NONSECRET OPERATOR INPUT TEMPLATE. Copy OUTSIDE the checkout; never add password values.
# Preparation only. The deterministic worker grader blocks actual learner deployment.
# Values are deliberately blank where an operator must select real resources.
HATOVE_APP_IMAGE=
HATOVE_CADDY_IMAGE=
OWNAPI_PG_DATABASE=
HATOVE_PG_ADMIN_USER=
OWNAPI_PG_SCHEMA=hatoove
OWNAPI_PG_ROLE_PREFIX=hatoove
# Fixed profile ceiling12; allocation must be measured against remaining DB capacity.
OWNAPI_PG_CONNECTION_BUDGET=
HATOVE_CADDY_DATA_VOLUME=
HATOVE_CADDY_CONFIG_VOLUME=
# Eight DIFFERENT externally generated password files, readable by the actual container user.
HATOVE_PG_ADMIN_PASSWORD_SOURCE=
HATOVE_PG_MIGRATION_PASSWORD_SOURCE=
HATOVE_PG_AUTH_PASSWORD_SOURCE=
HATOVE_PG_LEARNER_PASSWORD_SOURCE=
HATOVE_PG_WORKER_PASSWORD_SOURCE=
HATOVE_PG_DELETION_PASSWORD_SOURCE=
HATOVE_PG_PAYMENTS_PASSWORD_SOURCE=
HATOVE_PG_PROVISIONER_PASSWORD_SOURCE=
# Local-db variant only. Select a PostgreSQL17 image digest and a retained volume explicitly.
HATOVE_POSTGRES_IMAGE=
HATOVE_PG_DATA_VOLUME=
# Managed-db variant only. Never substitute an IP for a certificate's DNS identity.
HATOVE_MANAGED_PG_HOST=
HATOVE_MANAGED_PG_PORT=
HATOVE_PG_TRUST_DIR=
# Optional managed CA: omit this key entirely when using Node default trust roots.
# OWNAPI_PG_TLS_CA_FILE=/run/hatoove/pg-trust/provider-ca.pem
