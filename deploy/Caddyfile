{
	# No network-accessible administration endpoint and no trusted-proxy/IP inference.
	admin off
}

hatoove.com {
	# HTTP-01 stays reachable on origin80 for bootstrap AND renewal. Cloudflare must
	# forward its challenge path unchanged; blanket Always Use HTTPS stays off.
	# Caddy's built-in ACME challenge handler runs before the HTTP routes below.
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	# Compatible headers only. No CSP/HSTS policy is silently imposed on the client.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}

	# All files, authenticated routes and media remain subject to the Node router.
	# No cache, compression, body rewriting, error interception or mutation retry.
	reverse_proxy app:4321 {
		lb_retries 0
		header_up -Forwarded
		header_up -X-Real-IP
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
		transport http {
			compression off
		}
	}
}

# Keep the canonical redirect explicit, including when certificates are mounted
# manually. Caddy's built-in ACME challenge handler still runs before this route.
http://hatoove.com {
	redir https://hatoove.com{uri} 308
}

# Unconfigured Host values must receive an explicit refusal on both protocols.
http://, https:// {
	respond 421
}
